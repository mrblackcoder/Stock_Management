# Environment Variables Template
# Copy this file to .env.development or .env.production and fill in the values
# Note: Create React App requires REACT_APP_ prefix for environment variables

# API Backend URL
REACT_APP_API_URL=http://localhost:8080/api

# Application Information
REACT_APP_APP_NAME=Stock Management System
REACT_APP_APP_VERSION=1.0.0
REACT_APP_ENVIRONMENT=development

# Optional: key used to obfuscate values kept in localStorage.
# Every REACT_APP_* value is compiled into the browser bundle, so this is public
# by design - it is not a secret and not a security boundary. Leave it unset to
# use the built-in default.
# REACT_APP_ENCRYPTION_KEY=
